# 当前项目请先运行 npm run setup:local，自动生成 .env。
# 下面仅供手动连接已有 MySQL 时参考，不要覆盖已生成的密码。
HOST=0.0.0.0
PORT=3000
DB_MANAGED_LOCAL=false
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=task_town_app
DB_PASSWORD=replace_with_your_local_mysql_password
DB_NAME=task_town
# 本地手机访问时无需填写 APP_ORIGIN，按实际 Host 校验。
APP_TIMEZONE=Asia/Shanghai
COOKIE_SECURE=false
TRUST_PROXY=false
REGISTRATION_OPEN=true
